<?xml version="1.0"?>

<sdf version="1.9">

<model name="landing_pad">

  <static>true</static>

  <link name="pad">

    <visual name="visual">

  <geometry>
    <box>
      <size>2.5 2.5 0.05</size>
    </box>
  </geometry>

  <material>

    <ambient>1 0 0 1</ambient>

    <diffuse>1 0 0 1</diffuse>

    <specular>0.3 0.3 0.3 1</specular>

    <emissive>0.2 0 0 1</emissive>

  </material>

</visual>

    <collision name="collision">

      <geometry>

        <box>
          <size>2 2 0.05</size>
        </box>

      </geometry>

    </collision>

  </link>

</model>

</sdf>