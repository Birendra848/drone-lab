<?xml version="1.0"?>

<sdf version="1.9">

<model name="ship">

  <static>false</static>

  <link name="base_link">

    <pose>0 0 0.5 0 0 0</pose>

    <inertial>

      <mass>500</mass>

      <inertia>

        <ixx>100</ixx>
        <iyy>100</iyy>
        <izz>100</izz>

      </inertia>

    </inertial>

    <collision name="collision">

      <geometry>

        <box>

          <size>6 3 1</size>

        </box>

      </geometry>

    </collision>

    <visual name="visual">

      <geometry>

        <box>

          <size>6 3 1</size>

        </box>

      </geometry>

    </visual>

  </link>

  <include>

    <uri>model://landing_pad</uri>

    <name>landing_pad</name>

    <pose>0 0 1.03 0 0 0</pose>

</include>



</model>

</sdf>